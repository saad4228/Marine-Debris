# NADIR Backend
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nadir
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:3000

UPLOAD_DIR=storage/uploads
MODEL_PATH=new.pt
USE_STUB_MODEL=true

# Acoustic denoising (applied per channel before waterfall tiling)
DENOISE_ENABLED=true
# lee | median | bilateral | nlm | wavelet | none
DESPECKLE_METHOD=lee+bilateral
DESPECKLE_FILTER_SIZE=5
DENOISE_BEAM_PATTERN=true
DENOISE_DESTRIPE=true
DENOISE_REPAIR_BAD_PINGS=true
